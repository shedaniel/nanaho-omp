{
  "name": "nanaho-omp",
  "version": "0.1.1",
  "private": true,
  "description": "Nanaho provider setup and usage controls for oh-my-pi",
  "type": "module",
  "files": ["src", "README.md"],
  "omp": {
    "extensions": ["./src/index.ts"],
    "settings": {
      "baseUrl": {
        "type": "string",
        "description": "Nanaho gateway API base URL, including /v1",
        "env": "NANAHO_BASE_URL"
      }
    }
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "dev": "omp --extension ."
  },
  "devDependencies": {
    "@oh-my-pi/pi-ai": "18.11.1",
    "@types/bun": "^1.3.0",
    "typescript": "^5.9.3"
  },
  "dependencies": {
    "@oh-my-pi/pi-coding-agent": "18.11.1",
    "@oh-my-pi/pi-utils": "18.11.1",
    "zod": "^4.6.7"
  }
}
